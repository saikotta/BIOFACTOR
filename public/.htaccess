# ----------------------------------------------------------------------
# Next.js Static Export .htaccess for Hostinger Apache / LiteSpeed
# ----------------------------------------------------------------------

# Default Directory Index
DirectoryIndex index.html

# Prevent Directory Browsing
Options -Indexes

# Custom 404 Error Page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Force HTTPS behind Hostinger reverse proxy
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) If the request is for an existing real file, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 3) If missing trailing slash and folder exists, redirect to trailing slash with HTTPS
  # Preserving %{HTTP_HOST} avoids internal reverse proxy port (e.g. 8080) leaks
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{DOCUMENT_ROOT}/$1 -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # 4) Serve folder/index.html when trailing slash is requested
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 5) Serve standalone .html files if requested without extension (e.g., /journey -> /journey.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 6) Missing _next or static assets should return 404 header directly (prevents returning HTML as JS)
  RewriteCond %{REQUEST_URI} ^/_next/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|css|json|png|jpe?g|gif|svg|webp|ico|woff2?)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # 7) Fallback for non-existent page routes -> serve custom 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.html [L]
</IfModule>

# Cache-Control headers to ensure new uploads show immediately
<IfModule mod_headers.c>
  # HTML files: never cache aggressively so code deployments reflect instantly
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static assets with Next.js hashes or media assets can be cached
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
